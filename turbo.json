{
    "$schema": "https://turbo.build/json-schema.json",
    "ui": "tui",
    "globalDependencies": [
        "**/.env.*"
    ],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "outputs": [
                "dist/**",
                "build/**"
            ],
            "cache": true
        },
        "test": {
            "outputs": [
                "coverage/**"
            ],
            "cache": true
        },
        "lint": {
            "cache": false
        }
    }
}